+def _record_execution_provenance(circuit: CircuitSpec, outcome: dict) -> None:
+    """
+    Every call to production_execute() — the live /api/v1/quantum/execute
+    path — writes a provenance record, whether it succeeded or not. Before
+    this, only capability-governed invocations (/api/v1/capability/{id})
+    produced provenance; direct circuit execution left no audit trail.
+    """
+    payload_hash = hashlib.sha256(
+        json.dumps(circuit.to_dict(), sort_keys=True).encode("utf-8")
+    ).hexdigest()
+    result = outcome.get("result")
+    output_hash = (
+        hashlib.sha256(json.dumps(result, sort_keys=True).encode("utf-8")).hexdigest()
+        if result else ""
+    )
+    record_external_evidence({
+        "invocation_id":            outcome.get("execution_id", "unknown"),
+        "capability_id":            "quantum_execute",
+        "source":                   "production_execute",
+        "status":                   outcome.get("status"),
+        "payload_hash":             payload_hash,
+        "output_hash":              output_hash,
+        "provider_name":            (result or {}).get("provider_name"),
+        "backend_name":             (result or {}).get("backend_name"),
+        "execution_classification": (result or {}).get("execution_classification"),
+        "shots_used":               (result or {}).get("shots_used"),
+        "seed":                     (result or {}).get("seed"),
+        "errors":                   outcome.get("errors", []),
+        "ts":                       time.time(),
+    })
 
 
