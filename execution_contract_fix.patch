+def _new_execution_id(circuit: CircuitSpec) -> str:
+    """
+    Unique per-attempt execution ID. Not a determinism/replay hash (that's
+    make_payload_hash/make_output_hash in the capability layer) — this is a
+    correlation ID so a caller can trace one HTTP request to one execution
+    attempt in logs, provenance, and dashboards.
+    """
+    raw = f"{uuid.uuid4().hex}:{circuit.num_qubits}:{circuit.shots}:{circuit.seed}:{time.time()}"
+    return "exec_" + hashlib.sha256(raw.encode("utf-8")).hexdigest()[:24]
+
+
+def _classify_execution(result: ExecutionResult) -> str:
+    """
+    Explicit, unambiguous LIVE vs SIMULATED classification. Don't make callers
+    infer this from is_simulator/is_real_hardware on ExecutionResult — state
+    it as one field so API consumers can't misread it.
+    """
+    return "SIMULATED" if result.is_simulator else "LIVE_HARDWARE"
+
