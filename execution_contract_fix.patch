+def record_external_evidence(record: Dict[str, Any]) -> None:
+    """
+    Append a provenance record from a path that doesn't go through the full
+    invoke_capability() governance stack (e.g. direct quantum circuit
+    execution via /api/v1/quantum/execute). Uses the same persistent
+    evidence ledger so `/api/v1/governance/provenance` reflects ALL
+    executions, not just capability-governed ones.
+    """
+    _evidence_ledger.append(record)
+
+
 def get_provenance_status() -> dict:
     if hasattr(_evidence_ledger, "summary"):
         summ = _evidence_ledger.summary()
