         self._ms=0.0; self._min=float("inf"); self._max=0.0; self._last="IDLE"; self._err=None
     def record(self,r):
         self._t+=1; self._ms+=r.duration_ms
         self._min=min(self._min,r.duration_ms); self._max=max(self._max,r.duration_ms)
         self._last=r.status
-        if r.status=="SUCCESS": self._s+=1
-        else: self._f+=1; self._err=r.error
+        if r.status=="SUCCESS":
+            self._s+=1
+        elif r.status in _REJECTION_STATUSES:
+            # Rejected before execution (bad input, no authority, replay denied,
+            # missing dependency). Tracked for visibility, excluded from health.
+            self._r+=1; self._err=r.error
+        else:
+            # Genuine execution/runtime failure — this is what health should reflect.
+            self._f+=1; self._err=r.error
     def to_dict(self):
