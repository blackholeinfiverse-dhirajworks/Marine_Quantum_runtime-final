+        # (successes + real failures). Rejections are excluded from the ratio.
+        executed=self._s+self._f
+        h=("IDLE" if self._t==0
+           else "HEALTHY" if self._f==0
+           else "DEGRADED" if executed==0 or self._f/executed<0.25
+           else "UNHEALTHY")
         return {"capability_id":self.cid,"total_invocations":self._t,"success_count":self._s,
-                "failure_count":self._f,"avg_latency_ms":round(avg,3),
