+# Statuses returned when a request never reached execution — the gate that
+# stopped it did its job correctly. These are client-input/authorization
+# outcomes, not runtime or backend failures, and must not degrade health.
+_REJECTION_STATUSES = {
+    "VALIDATION_ERROR", "DEPENDENCY_ERROR", "AUTHORITY_DENIED", "REPLAY_DENIED",
+}
+
 class _CapMetrics:
     def __init__(self,cid):
-        self.cid=cid; self._t=0; self._s=0; self._f=0
